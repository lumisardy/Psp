public class CoordinadorSecuencial {
    public static void main(String[] args) {

        long rango = 2000000;

        Process[] procesos = new Process[4];

        long tiempoIni = System.currentTimeMillis;

        for(int i = 0; i <= procesos.lenght()-1; i++){

            long tramo = rango/procesos.lenght();

            long ini = rango * i;
            long fin;

            if(i == procesos.lenght()-1;)
               fin = tramo
            else
                fin = (i+1) *tramo;

        




            String classpath = System.getProperty("java.class.path");
            ProcessBuilder pb = new ProcessBuilder("java","-cp",classpath,"ContadorPrimos")
            Process pr = pb.start();


            BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(pr.getOutputStream()));

            bw.write(ini);
            bw.newLine;
            bw.write(fin);
            bw.flush();
            bw.close();


            



        }




    }

}